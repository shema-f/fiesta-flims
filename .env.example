# ---------------------------------------------------------------------------
# Fiesta Flix environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL / Neon recommended) ------------------------------
# Neon pooled connection string. Use the "-pooler" host for serverless.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/fiesta?sslmode=require

# --- Auth ------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
JWT_SECRET=

# --- AI --------------------------------------------------------------------
GEMINI_API_KEY=

# --- Security --------------------------------------------------------------
# Salt used to hash viewer IPs for analytics (never store raw IPs).
IP_HASH_SALT=
# Protects /api/cron/* endpoints. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# --- Media processing (worker only) ---------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_PRESET=veryfast
MAX_UPLOAD_BYTES=21474836480
WORKER_POLL_MS=5000
# Hot/cold tiering thresholds
TIER_HOT_VIEWS=10000
TIER_COLD_VIEWS=10
TIER_COLD_IDLE_DAYS=90

# --- Storage provider: Cloudflare R2 (HOT) --------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_KEY_PREFIX=fiesta-flix

# --- Storage provider: Backblaze B2 (HOT/WARM) ----------------------------
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=
BACKBLAZE_ENDPOINT=s3.us-east-001.backblazeb2.com
BACKBLAZE_REGION=us-east-001
BACKBLAZE_KEY_PREFIX=fiesta-flix

# --- Storage provider: Amazon S3 / generic S3 -----------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
AWS_S3_KEY_PREFIX=fiesta-flix
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=
S3_KEY_PREFIX=fiesta-flix

# --- Storage provider: Telegram (COLD) ------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage provider: Google Drive (COLD) --------------------------------
# Prefer a service account; OAuth refresh token also supported.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Storage provider: MediaFire (COLD, optional) -------------------------
MEDIAFIRE_APP_ID=
MEDIAFIRE_SESSION_TOKEN=

# --- Cloudflare (CDN / zone) ----------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
